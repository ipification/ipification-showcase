PORT=3002
APP_ENV=development
# Use 1 behind a single trusted Kubernetes ingress / reverse proxy.
TRUST_PROXY_HOPS=0
# NODE_CONFIG_DIR=/absolute/path/to/private/config

# Provider request deadline in milliseconds (1..120000; invalid values use 15000).
PROVIDER_HTTP_TIMEOUT_MS=15000
# Authentication rate limits, per operation (defaults: 20 per IP and 5 per identity per minute).
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# AUTH_RATE_LIMIT_IP_MAX=20
# AUTH_RATE_LIMIT_IDENTITY_MAX=5

# Play Integrity endpoints require these values when called.
# PLAY_INTEGRITY_PACKAGE_NAME=com.example.app
# PLAY_INTEGRITY_USER_FLOW=pvn_ip
# PLAY_INTEGRITY_STATE_SECRET=<long-random-secret>
# PLAY_INTEGRITY_STATE_ISSUER=showcase
# PLAY_INTEGRITY_STATE_AUDIENCE=showcase-app
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
