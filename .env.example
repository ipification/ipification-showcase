PORT=3002
APP_ENV=development
# Use 1 behind a single trusted Kubernetes ingress / reverse proxy.
TRUST_PROXY_HOPS=0
# NODE_CONFIG_DIR=/absolute/path/to/private/config
# PLAY_INTEGRITY_ENABLED=false

# Provider request deadline in milliseconds (1..120000; invalid values use 15000).
PROVIDER_HTTP_TIMEOUT_MS=15000
