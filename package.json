{
  "name": "ipification-showcase",
  "version": "1.2.17",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.0"
  },
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "build": "tsc --noEmit",
    "start": "NODE_ENV=production node --import tsx src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "config:check": "node scripts/check-config.mjs",
    "docs:build": "typedoc"
  },
  "dependencies": {
    "@isaacs/ttlcache": "^2.1.5",
    "axios": "^1.21.1",
    "config": "^5.0.1",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "geoip-lite": "^2.0.3",
    "google-auth-library": "^11.3.4",
    "intl-tel-input": "^29.5.11",
    "jsonwebtoken": "^9.0.3",
    "openid-client": "^6.9.1",
    "pino": "^10.4.0",
    "qrcode-generator": "^2.0.4",
    "qs": "^6.17.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/config": "^3.3.5",
    "@types/express": "^5.0.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/qs": "^6.15.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
