<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><link rel="stylesheet" href="/css/showcase.css"><title>IPification Showcase</title>
</head>
<body>
<main class="showcase-error-page">
<article>
<div class="error-icon" aria-hidden="true">ⓘ</div><p class="error-brand">IPification Showcase</p><h1><%= failure.title %></h1><p><%= failure.description %></p>
<div class="error-advice"><h2>What you can do</h2><p><%= failure.action %></p>
</div><details><summary>Error details</summary><dl><dt>Error code</dt><dd><%= reason %></dd><% if (stage) { %><dt>Step</dt><dd><%= stage %></dd><% } %><% if (status) { %><dt>Provider HTTP status</dt><dd><%= status %></dd><% } %><% if (provider) { %><dt>Provider error</dt><dd><%= provider %></dd><% } %></dl></details><% if (reference) { %><p class="error-reference">Support reference: <%= reference %></p><% } %><a class="error-return" href="/auth/login"><span aria-hidden="true">← &nbsp;</span>Try again</a>
</article>
</main>
</body>
</html>
